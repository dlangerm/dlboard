  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "dlboard"
  ],
  "templating": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(dlboard_server_workers, job)",
        "description": "The Prometheus job of the dlboard server to show: its scrape job, or OTEL_SERVICE_NAME when it pushes over OTLP. Only jobs that report dlboard's own metrics are listed, so another service's http_server_* series are never mixed in.",
        "label": "Service",
        "name": "job",
        "query": {
          "query": "label_values(dlboard_server_workers, job)",
          "refId": "job"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(dlboard_server_workers{job=~\"$job\"}, deployment_environment)",
        "description": "Which deployment, for servers that share a service name: the deployment_environment label (OTEL_RESOURCE_ATTRIBUTES=deployment.environment=..., promoted to a label, or a label the scrape adds). All, for servers that don't set one.",
        "includeAll": true,
        "label": "Environment",
        "name": "environment",
        "query": {
          "query": "label_values(dlboard_server_workers{job=~\"$job\"}, deployment_environment)",
          "refId": "environment"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "dlboard",
  "uid": "dlboard-overview",
  "version": 2
}
