      "id": 35,
      "targets": [
        {
          "expr": "sum(rate(dlboard_webhook_refused_addresses_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "A"
        }
      ],
      "title": "Webhook posts refused for their address",
      "type": "timeseries"
    }
