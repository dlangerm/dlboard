{
  "__inputs": [
    {
      "description": "The Prometheus that scrapes dlboard's /metrics, or the one the OTLP metrics land in",
      "label": "Prometheus",
      "name": "DS_PROMETHEUS",
      "pluginId": "prometheus",
      "pluginName": "Prometheus",
      "type": "datasource"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Operational metrics for a dlboard server. Every series is documented in docs/telemetry.md.",
  "editable": true,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Server",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Server worker processes that are up. Zero or absent means the server is down.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(dlboard_server_workers{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "refId": "A"
        }
      ],
      "title": "Workers reporting",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Requests per second",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment=~\"$environment\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Share of requests that failed (5xx)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(http_server_active_requests{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "refId": "A"
        }
      ],
      "title": "Requests in flight",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The 95th percentile of how long a request took, per route template (not the URL) and HTTP method. The same route can be served by GET and POST, and they are kept apart here.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route, http_request_method) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Request latency by route and method (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Requests per second by status",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 8,
      "panels": [],
      "title": "Ingest from training runs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(dlboard_ingest_metric_values_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "metric values",
          "refId": "A"
        }
      ],
      "title": "Metric values accepted per second",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum(rate(dlboard_ingest_artifacts_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "artifacts per second",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dlboard_ingest_artifact_size_bytes_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "bytes per second",
          "refId": "B"
        }
      ],
      "title": "Artifacts uploaded",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 11,
      "panels": [],
      "title": "Artifact pipeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "queue_full, writer_down or failed. Any sustained rate here means the artifact writer is behind or down; Uploads held climbing comes first.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (dlboard_rejection_reason) (rate(dlboard_artifact_write_queue_rejections_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dlboard_rejection_reason}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dlboard_artifact_writer_restarts_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "blob writer restarts",
          "refId": "B"
        }
      ],
      "title": "Uploads turned away, by reason",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Uploads answered for but not yet written and recorded: the depth of the artifact queues. A worker turns uploads away (queue_full) once it holds DLBOARD_FILESYSTEM_STORE_QUEUE_SIZE or DLBOARD_S3_QUEUE_SIZE (100 by default). Pushed over OTLP, each worker is a series of its own, and the busiest worker's line reaching that is the limit. Scraped from /metrics, the workers are added up, both lines are the total, and the limit is the queue size times the number of workers. Above zero with no uploads coming in, the store is refusing writes. Where they wait says which is behind: to write (the object store or disk), to retry (writes the store refused), or to ingest (the database recording their refs).",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "id": 28,
      "targets": [
        {
          "expr": "max(dlboard_artifact_uploads_held{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "legendFormat": "the busiest worker",
          "refId": "A"
        },
        {
          "expr": "sum(dlboard_artifact_uploads_held{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "legendFormat": "every worker",
          "refId": "B"
        },
        {
          "expr": "sum by (dlboard_artifact_stage) (dlboard_artifact_queue_depth{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "legendFormat": "waiting to {{dlboard_artifact_stage}}",
          "refId": "C"
        }
      ],
      "title": "Uploads held, and where they wait",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long an upload waited for the writer, and a written artifact waited for its batch to be recorded. Rising first is the early warning for rejections.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dlboard_artifact_write_queue_wait_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "waiting for the writer",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dlboard_artifact_ingest_queue_wait_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "waiting for the batch",
          "refId": "B"
        }
      ],
      "title": "Time waiting in the queues (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "id": 14,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dlboard_artifact_stage_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "staging the upload",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_outcome) (rate(dlboard_artifact_blob_write_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "writing to the store, {{dlboard_outcome}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_outcome) (rate(dlboard_artifact_ingest_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "recording the refs, {{dlboard_outcome}}",
          "refId": "C"
        }
      ],
      "title": "Handling one artifact, step by step (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "id": 15,
      "targets": [
        {
          "expr": "sum by (dlboard_outcome) (rate(dlboard_artifact_purges_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dlboard_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Artifact purges, by outcome",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 16,
      "panels": [],
      "title": "Experiment pages",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One panel on an experiment page reading one kind of data. Slow kinds here are what makes a page slow.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "id": 17,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_panel_read) (rate(dlboard_panel_read_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{dlboard_panel_read}}",
          "refId": "A"
        }
      ],
      "title": "Panel reads from the store (p95), by kind",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 18,
      "panels": [],
      "title": "Runs and sign-ins",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "id": 19,
      "targets": [
        {
          "expr": "sum(rate(dlboard_runs_created_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "started",
          "refId": "A"
        },
        {
          "expr": "sum by (dlboard_run_status) (rate(dlboard_runs_finished_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "finished {{dlboard_run_status}}",
          "refId": "B"
        }
      ],
      "title": "Runs started and finished",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "A burst of wrong_credentials or throttled is worth a look.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "id": 20,
      "targets": [
        {
          "expr": "sum by (dlboard_auth_outcome) (rate(dlboard_auth_sign_ins_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dlboard_auth_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Sign-in attempts, by outcome",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "id": 21,
      "panels": [],
      "title": "Background tasks",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Runs of each background task. Any failure or hung is worth a look; hung means the task did not stop when asked.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "id": 22,
      "targets": [
        {
          "expr": "sum by (dlboard_task, dlboard_outcome) (rate(dlboard_task_runs_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dlboard_task}} {{dlboard_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Task runs, by task and outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "id": 23,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_task) (rate(dlboard_task_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{dlboard_task}}",
          "refId": "A"
        }
      ],
      "title": "One run of a task (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "What each task last said it had left to do. Growing over several runs means it cannot keep up.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "id": 24,
      "targets": [
        {
          "expr": "sum by (dlboard_task) (dlboard_task_backlog{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "legendFormat": "{{dlboard_task}}",
          "refId": "A"
        }
      ],
      "title": "Backlog, by task",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "More than one per server start means the server replaced a custodian that died or hung.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "id": 25,
      "targets": [
        {
          "expr": "sum(increase(dlboard_custodian_starts_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "custodian starts",
          "refId": "A"
        }
      ],
      "title": "Custodian starts",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "id": 26,
      "panels": [],
      "title": "Retention",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Runs a retention rule moved to the Trash, and new runs a locked project turned away. Refusals mean a project is far behind its rule.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 75
      },
      "id": 27,
      "targets": [
        {
          "expr": "sum(rate(dlboard_retention_runs_deleted_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "deleted",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dlboard_retention_runs_refused_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "refused",
          "refId": "B"
        }
      ],
      "title": "Runs deleted and refused by retention",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 83
      },
      "id": 29,
      "panels": [],
      "title": "Database",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Postgres connections in use and idle, every worker's pool added up. Each worker may open DLBOARD_POSTGRES_POOL_SIZE plus DLBOARD_POSTGRES_MAX_OVERFLOW (5 + 10 by default): in use approaching that times the number of workers, requests start waiting for one. Pushed over OTLP, each worker is a series of its own.",
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 84
      },
      "id": 30,
      "targets": [
        {
          "expr": "sum by (dlboard_db_pool_state) (dlboard_db_pool_connections{job=~\"$job\", deployment_environment=~\"$environment\"})",
          "legendFormat": "{{dlboard_db_pool_state}}",
          "refId": "A"
        }
      ],
      "title": "Database connections",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Requests turned away with a 503 after waiting DLBOARD_POSTGRES_POOL_TIMEOUT_S for a connection: the pool is too small for the load, or the database too slow to give connections back.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 84
      },
      "id": 31,
      "targets": [
        {
          "expr": "sum(rate(dlboard_db_pool_timeouts_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "timed out",
          "refId": "A"
        }
      ],
      "title": "Requests that waited out the pool",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 92
      },
      "id": 32,
      "panels": [],
      "title": "Webhooks",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "What became of each webhook delivery the custodian settled: delivered, tried again later, refused by its receiver, its webhook turned off, not wanted any more (its webhook deleted or off), or expired (its run ended longer ago than DLBOARD_WEBHOOK_EXPIRE_H).",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 93
      },
      "id": 33,
      "targets": [
        {
          "expr": "sum by (dlboard_webhook_outcome) (rate(dlboard_webhook_deliveries_total{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dlboard_webhook_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Webhook deliveries, by outcome",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long a webhook post took, until it was answered or given up on (twice DLBOARD_WEBHOOK_TIMEOUT_S at the most).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 93
      },
      "id": 34,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_outcome) (rate(dlboard_webhook_post_duration_seconds_bucket{job=~\"$job\", deployment_environment=~\"$environment\"}[$__rate_interval])))",
          "legendFormat": "{{dlboard_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Webhook post time (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Posts not made because the webhook's host resolves to an address that isn't public: an internal host an admin hasn't listed in DLBOARD_WEBHOOK_ALLOWED_HOSTS, or a URL aimed at the server's own network.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
