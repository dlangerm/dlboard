{
  "__inputs": [
    {
      "description": "The Prometheus that scrapes dlboard's /metrics, or the one the OTLP metrics land in",
      "label": "Prometheus",
      "name": "DS_PROMETHEUS",
      "pluginId": "prometheus",
      "pluginName": "Prometheus",
      "type": "datasource"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Operational metrics for a dlboard server. Every series is documented in docs/telemetry.md.",
  "editable": true,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Server",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Server worker processes that are up. Zero or absent means the server is down.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(dlboard_server_workers)",
          "refId": "A"
        }
      ],
      "title": "Workers reporting",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Requests per second",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Share of requests that failed (5xx)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(http_server_active_requests)",
          "refId": "A"
        }
      ],
      "title": "Requests in flight",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The 95th percentile of how long a request took, per route template (not the URL) and HTTP method. The same route can be served by GET and POST, and they are kept apart here.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route, http_request_method) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Request latency by route and method (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "Requests per second by status",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 8,
      "panels": [],
      "title": "Ingest from training runs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum(rate(dlboard_ingest_metric_values_total[$__rate_interval]))",
          "legendFormat": "metric values",
          "refId": "A"
        }
      ],
      "title": "Metric values accepted per second",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bytes per second"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum(rate(dlboard_ingest_artifacts_total[$__rate_interval]))",
          "legendFormat": "artifacts per second",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dlboard_ingest_artifact_size_bytes_total[$__rate_interval]))",
          "legendFormat": "bytes per second",
          "refId": "B"
        }
      ],
      "title": "Artifacts uploaded",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "id": 11,
      "panels": [],
      "title": "Artifact pipeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "queue_full, writer_down or failed. Any sustained rate here means the artifact writer is behind or down.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum by (dlboard_rejection_reason) (rate(dlboard_artifact_write_queue_rejections_total[$__rate_interval]))",
          "legendFormat": "{{dlboard_rejection_reason}}",
          "refId": "A"
        }
      ],
      "title": "Uploads turned away, by reason",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "How long an upload waited for the writer, and a written artifact waited for its batch to be recorded. Rising first is the early warning for rejections.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dlboard_artifact_write_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "waiting for the writer",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dlboard_artifact_ingest_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "waiting for the batch",
          "refId": "B"
        }
      ],
      "title": "Time waiting in the queues (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "id": 14,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_outcome) (rate(dlboard_artifact_blob_write_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{dlboard_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Writing one artifact to the store (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "id": 15,
      "targets": [
        {
          "expr": "sum by (dlboard_outcome) (rate(dlboard_artifact_purges_total[$__rate_interval]))",
          "legendFormat": "{{dlboard_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Artifact purges, by outcome",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 16,
      "panels": [],
      "title": "Experiment pages",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One panel on an experiment page reading one kind of data. Slow kinds here are what makes a page slow.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "id": 17,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, dlboard_panel_read) (rate(dlboard_panel_read_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{dlboard_panel_read}}",
          "refId": "A"
        }
      ],
      "title": "Panel reads from the store (p95), by kind",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "id": 18,
      "panels": [],
      "title": "Runs and sign-ins",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "id": 19,
      "targets": [
        {
          "expr": "sum(rate(dlboard_runs_created_total[$__rate_interval]))",
          "legendFormat": "started",
          "refId": "A"
        },
        {
          "expr": "sum by (dlboard_run_status) (rate(dlboard_runs_finished_total[$__rate_interval]))",
          "legendFormat": "finished {{dlboard_run_status}}",
          "refId": "B"
        }
      ],
      "title": "Runs started and finished",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "A burst of wrong_credentials or throttled is worth a look.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "id": 20,
      "targets": [
        {
          "expr": "sum by (dlboard_auth_outcome) (rate(dlboard_auth_sign_ins_total[$__rate_interval]))",
          "legendFormat": "{{dlboard_auth_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Sign-in attempts, by outcome",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "dlboard"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "dlboard",
  "uid": "dlboard-overview",
  "version": 2
}
