# Copy this to `.env` and adjust what you need -- `uv run --env-file .env dltrack serve local`
# (and any `dltrack serve ...` invocation) reads it. Every setting here has a sane default, so an
# empty `.env` runs fine; this just documents the knobs you're most likely to touch for local dev.
#
# `dltrack serve local` (anonymous, single-user, sqlite + local disk) needs none of these -- they
# matter once you switch to `serve custom` with Postgres/S3/password auth. See docs/docker.md and
# docs/plugins/*.md for the full per-plugin settings lists.

# Where the sqlite metadata DB and local artifact blobs live (LOCAL_DEPLOYMENT's storage).
# DLTRACK_SQLITE_LOCATION=~/.dltrack.sqlite
# DLTRACK_ARTIFACT_STORE_LOCATION=~/.dltrack_artifacts

# Required once you swap in `dltrack.plugins.PASSWORD_AUTH` -- signs session cookies. Generate with
# `openssl rand -hex 32`. Must match across every worker process.
# DLTRACK_SECRET_KEY=

# Required once you swap in `dltrack.plugins.POSTGRES_STORAGE`/`POSTGRES_S3_STORAGE`.
# DLTRACK_POSTGRES_HOST=
# DLTRACK_POSTGRES_PORT=5432
# DLTRACK_POSTGRES_DATABASE=dltrack
# DLTRACK_POSTGRES_USER=dltrack
# DLTRACK_POSTGRES_PASSWORD=

# Required once you swap in `dltrack.plugins.POSTGRES_S3_STORAGE` instead of local-disk artifacts.
# DLTRACK_S3_BUCKET=
# DLTRACK_S3_ENDPOINT_URL=
# DLTRACK_S3_ADDRESSING_STYLE=path

# Hard cap on any single request body (mainly artifact uploads), in MB.
# DLTRACK_MAX_UPLOAD_MB=256

# Comma-separated usernames granted admin whenever they sign in -- how to make the first admin.
# DLTRACK_ADMIN_USERS=

# Client-side: point a training script's DLTrackLogger at a signed-in server.
# DLTRACK_API_KEY=
