# Copy this to `.env` and adjust what you need -- `uv run --env-file .env dlboard serve local`
# (and any `dlboard serve ...` invocation) reads it. Every setting here has a sane default, so an
# empty `.env` runs fine; this just documents the knobs you're most likely to touch for local dev.
#
# `dlboard serve local` (anonymous, single-user, sqlite + local disk) needs none of these -- they
# matter once you switch to `serve custom` with Postgres/S3/password auth. See docs/docker.md and
# docs/plugins/*.md for the full per-plugin settings lists.

# Where the sqlite metadata DB and local artifact blobs live (LOCAL_DEPLOYMENT's storage).
# DLBOARD_SQLITE_LOCATION=.dlboard/db.sqlite
# DLBOARD_ARTIFACT_STORE_LOCATION=.dlboard/artifacts/

# Required once you swap in `dlboard.plugins.PASSWORD_AUTH` -- signs session cookies. Generate with
# `openssl rand -hex 32`. Must match across every worker process.
# DLBOARD_SECRET_KEY=

# Required once you swap in `dlboard.plugins.POSTGRES_STORAGE`/`POSTGRES_S3_STORAGE`.
# DLBOARD_POSTGRES_HOST=
# DLBOARD_POSTGRES_PORT=5432
# DLBOARD_POSTGRES_DATABASE=dlboard
# DLBOARD_POSTGRES_USER=dlboard
# DLBOARD_POSTGRES_PASSWORD=

# Required once you swap in `dlboard.plugins.POSTGRES_S3_STORAGE` instead of local-disk artifacts.
# DLBOARD_S3_BUCKET=
# DLBOARD_S3_ENDPOINT_URL=
# DLBOARD_S3_ADDRESSING_STYLE=path

# Hard cap on any single request body (mainly artifact uploads), in MB.
# DLBOARD_MAX_UPLOAD_MB=256

# Comma-separated usernames granted admin whenever they sign in -- how to make the first admin.
# DLBOARD_ADMIN_USERS=

# Client-side: point a training script's DLBoardLogger at a signed-in server.
# DLBOARD_API_KEY=

# Export the server's own metrics (and logs) for Prometheus or an OpenTelemetry collector. Off unless set;
# needs `pip install 'dlboard[otel]'`. See docs/telemetry.md.
# DLBOARD_TELEMETRY_METRICS=prometheus,otlp
# DLBOARD_TELEMETRY_LOGS=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
